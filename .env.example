# Copy to .env and fill in. Never commit .env.
# Hugging Face token (only needed for `make publish-hf`, which asks before uploading)
HF_TOKEN=
# Teacher / system (d): open-weight Apache-2.0 checkpoint, run on Kaggle (no paid API)
TEACHER_MODEL=mistralai/Mistral-Small-24B-Instruct-2501
# Student model fine-tuned with QLoRA
STUDENT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
